# ==============================================================================
# Network Device Monitoring & Predictive Fault Analysis System - Backend Config
# ==============================================================================
# Instructions:
# 1. Copy this template to a file named '.env' in this directory:
#    cp .env.example .env
# 2. Update with your local PostgreSQL database credentials.
# ==============================================================================

# PostgreSQL Database Connection URL
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/network_monitoring_db

# Optional Server Settings
PORT=8000
HOST=127.0.0.1
